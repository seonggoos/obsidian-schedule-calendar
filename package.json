{
  "name": "obsidian-schedule-calendar",
  "version": "1.3.0",
  "type": "module",
  "description": "Visual drag-and-drop calendar for daily and weekly schedule notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test",
    "lint": "eslint src",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run lint && npm run typecheck && npm test",
    "release:check": "npm run check && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.8.7",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
  }
}
