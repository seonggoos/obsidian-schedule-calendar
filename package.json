{
  "name": "obsidian-schedule-calendar",
  "version": "1.2.0",
  "description": "Visual drag-and-drop calendar for daily and weekly schedule notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run typecheck && npm test",
    "release:check": "npm run check && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
"esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
